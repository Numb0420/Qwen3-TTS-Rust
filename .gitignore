# Rust: application lockfiles are committed for reproducible builds
/target/
**/target/
/.cargo-home/
/debug/
/release/

# Model weights: allow only documentation and verification metadata
/models/*
!/models/base-1.7b/
/models/base-1.7b/*
!/models/base-1.7b/README.md
!/models/base-1.7b/checkpoint-manifest.json
!/models/base-1.7b/onnx/
/models/base-1.7b/onnx/*
!/models/base-1.7b/onnx/qwen3_tts_decoder_state_only.json
*.onnx
*.gguf
*.safetensors
*.pth
*.pt
*.bin
*.npz
*.npy
*.f32
*.qvoice

# Local audio and extracted voice data
*.wav
*.mp3
*.flac
/speakers/*
!/speakers/README.md

# Runtime, portable distributions, snapshots and experiment environments
/runtime/
/dist/
/baselines/
/diagnostics/
*.dll
*.exe
*.pdb
*.so
*.dylib
*.zip
*.7z
*.tar.gz
*.part

# Logs and temporary files
/logs/
*.log
*.tmp
*.temp
*.bak
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
/pr_body.md

# IDE and OS
/.trae/
.idea/
.vscode/
*.iml
Thumbs.db
Desktop.ini
.DS_Store
